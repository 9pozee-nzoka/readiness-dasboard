APP_NAME="KSG Events"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://stmaryimc.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (Update with Truehost MySQL details)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stmaryim_readiness
DB_USERNAME=stmaryim_user
DB_PASSWORD=CHANGE_THIS_PASSWORD

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.stmaryimc.co.ke
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Redis (if available on Truehost)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (Update with your SMTP details)
MAIL_MAILER=smtp
MAIL_HOST=mail.stmaryimc.co.ke
MAIL_PORT=587
MAIL_USERNAME=noreply@stmaryimc.co.ke
MAIL_PASSWORD=CHANGE_THIS_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@stmaryimc.co.ke
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Primary admin account
ADMIN_EMAIL=admin@stmaryimc.co.ke
ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
ADMIN_NAME="System Administrator"
